{
  "name": "playtivity-build-tools",
  "version": "1.0.0",
  "description": "Playtivity Android app and build tools",
  "scripts": {
    "build": "bun scripts/build-apk.js",
    "build:patch": "bun scripts/build-apk.js patch",
    "build:minor": "bun scripts/build-apk.js minor",
    "build:major": "bun scripts/build-apk.js major",
    "release": "bun scripts/release-apk.js",
    "release:patch": "bun scripts/release-apk.js patch",
    "release:minor": "bun scripts/release-apk.js minor",
    "release:major": "bun scripts/release-apk.js major",
    "release:apk-only": "bun scripts/release-apk.js --no-bundle",
    "nightly": "bun scripts/nightly.js",
    "nightly:local": "bun scripts/nightly.js --skip-github",
    "nightly:stable": "bun scripts/nightly.js --stable",
    "nightly:clean": "bun scripts/nightly.js --clean",
    "nightly:keep-10": "bun scripts/nightly.js --keep 10",
    "nightly:promote": "bun scripts/nightly-release.js",
    "nightly:promote-patch": "bun scripts/nightly-release.js patch",
    "nightly:promote-minor": "bun scripts/nightly-release.js minor",
    "nightly:promote-major": "bun scripts/nightly-release.js major",
    "list": "bun scripts/list-commands.js",
    "help": "bun scripts/build-apk.js --help",
    "help:release": "bun scripts/release-apk.js --help",
    "help:nightly": "bun scripts/nightly.js --help",
    "help:nightly-promote": "bun scripts/nightly-release.js --help",
    "android": "cd native && ./gradlew :app:assemblePreviewDebug",
    "check": "cd native && ./gradlew :core:testDebugUnitTest :app:lintPreviewDebug :app:assemblePreviewDebug"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "author": "Playtivity Team",
  "license": "MIT",
  "keywords": [
    "android",
    "apk",
    "kotlin",
    "build",
    "release",
    "nightly",
    "github"
  ],
  "dependencies": {
    "ws": "^8.18.3"
  }
}
