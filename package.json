{
  "name": "playtivity-build-tools",
  "version": "1.0.0",
  "description": "Playtivity: Spotify friend activity app (Expo, Bun, NativeWind)",
  "scripts": {
    "build": "bun scripts/build-apk.js",
    "build:patch": "bun scripts/build-apk.js patch",
    "build:minor": "bun scripts/build-apk.js minor",
    "build:major": "bun scripts/build-apk.js major",
    "release": "bun scripts/release-apk.js",
    "release:patch": "bun scripts/release-apk.js patch",
    "release:minor": "bun scripts/release-apk.js minor",
    "release:major": "bun scripts/release-apk.js major",
    "release:apk-only": "bun scripts/release-apk.js --no-bundle",
    "nightly": "bun scripts/nightly.js",
    "nightly:local": "bun scripts/nightly.js --skip-github",
    "nightly:stable": "bun scripts/nightly.js --stable",
    "nightly:clean": "bun scripts/nightly.js --clean",
    "nightly:keep-10": "bun scripts/nightly.js --keep 10",
    "nightly:promote": "bun scripts/nightly-release.js",
    "nightly:promote-patch": "bun scripts/nightly-release.js patch",
    "nightly:promote-minor": "bun scripts/nightly-release.js minor",
    "nightly:promote-major": "bun scripts/nightly-release.js major",
    "list": "bun scripts/list-commands.js",
    "help": "bun scripts/build-apk.js --help",
    "help:release": "bun scripts/release-apk.js --help",
    "help:nightly": "bun scripts/nightly.js --help",
    "help:nightly-promote": "bun scripts/nightly-release.js --help",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "author": "Playtivity Team",
  "license": "MIT",
  "keywords": [
    "android",
    "apk",
    "flutter",
    "build",
    "release",
    "nightly",
    "github"
  ],
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/hashes": "^2.4.0",
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "^58.0.21",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "^58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "nativewind": "4.2.7",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-android-widget": "^0.25.0",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "tailwindcss": "3.4.17",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "^58.0.22",
    "typescript": "^7.0.2"
  }
}
