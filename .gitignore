# is commented out by default.
#.vscode/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Environment variables
.env

# Release signing / secrets
*.jks
*.keystore
*.base64.txt

# Build tooling output (scripts/build-apk.js, scripts/nightly.js, etc.)
*.apk
/nightly
delete-releases.js
/.omc

# Node (root package.json build tooling + landing/)
/node_modules/

# Internal planning docs (not meant to be committed)
/docs/superpowers/

# Misc tooling
/.playwright-mcp/
/coverage/
.superpowers/
docs/superpowers/

